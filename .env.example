# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Backend Server Configuration
PORT=5001
NODE_ENV="development"

# MongoDB Database Configuration (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecoloop?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/ecoloop
MONGODB_URI="mongodb://127.0.0.1:27017/ecoloop"
MONGODB_DB_NAME="ecoloop"

# Authentication & Session Secrets
JWT_SECRET="your-256-bit-jwt-secret-key-change-in-production"
SESSION_SECRET="your-session-secret-key-change-in-production"

# Trusted SuperAdmin Provisioning (Created automatically on server startup)
SUPERADMIN_EMAIL="superadmin@ecoloop.org"
SUPERADMIN_PASSWORD="ChangeMeSuperAdmin2026!"

# Email Verification Provider (Optional: SMTP / SendGrid / Resend)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@ecoloop.org"

